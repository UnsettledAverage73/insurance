# Fast hosted inference (recommended for 2-3s live demo execution)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local Ollama fallback if GROQ_API_KEY is unset
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Storage paths
LANCEDB_DIR=./.lancedb
AUDIT_LOG_PATH=./.audit_log.jsonl
